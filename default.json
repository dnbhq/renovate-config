{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default configuration for Renovate in all @davidsneighbour projects",
  "timezone": "Asia/Bangkok",
  "schedule": [
    "* 21-23,0-4 * * 5,6"
  ],
  "automerge": false,
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)",
    ":disableDependencyDashboard"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/_vendor/**",
    "**/scratch/**"
  ],
  "onboarding": false,
  "packageRules": [
    {
      "automerge": true,
      "automergeSchedule": [
        "at any time"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "groupName": "davidsneighbour",
      "ignoreTests": true,
      "matchPackageNames": [
        "@davidsneighbour/**"
      ]
    },
    {
      "automerge": true,
      "automergeSchedule": [
        "at any time"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "groupName": "dnbhq",
      "ignoreTests": true,
      "matchPackageNames": [
        "@dnbhq/**"
      ]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "/eslint/"
      ]
    },
    {
      "groupName": "remark",
      "matchPackageNames": [
        "/remark/"
      ]
    }
  ],
  "additionalBranchPrefix": "{{parentDir}}/",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": [
      "* 21-23,0-4 * * 5,6"
    ],
    "commitMessageAction": "build(deps): update lockfile dependencies"
  }
}
